# General
SECRET_KEY=some_random_session_secret_key_here
JWT_SECRET_KEY=some_random_jwt_secret_key_here

# Database
# Leave blank to use local SQLite (rent_flatmate.db) or specify a PostgreSQL URI
# DATABASE_URL=postgresql://user:password@localhost:5432/rent_flatmate

# Mail Configuration
MAIL_SERVER=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_DEFAULT_SENDER=noreply@rentflatmate.com

# AI Scorer Integration
OPENAI_API_KEY=your_openai_api_key_here
