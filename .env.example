# Flask Application configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=your_super_secret_session_key_here
JWT_SECRET_KEY=your_jwt_secret_token_key_here

# Database Configuration (Defaults to local instance/rent_flatmate.db if left empty)
DATABASE_URL=sqlite:///instance/rent_flatmate.db

# OpenAI API Key (Required for AI compatibility calculations, defaults to structured rule fallback if empty)
OPENAI_API_KEY=your_openai_api_key_here

# Mailer / SMTP Configurations (For interest requests and booking notification emails)
MAIL_SERVER=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_smtp_username_here
MAIL_PASSWORD=your_smtp_password_here
MAIL_DEFAULT_SENDER=no-reply@staylio.com
